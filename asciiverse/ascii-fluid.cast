[0.019, "o", "\u001b[4;47H\u001b[48;5;46m--\u001b[5;38H\u001b[48;5;19m.\u001b[48;5;17m,\u001b[5;47H\u001b[48;5;20m_\u001b[48;5;19m.\u001b[5;52H\u001b[48;5;17m.\u001b[48;5;19m,\u001b[6;38H\u001b[48;5;21m|\u001b[6;43H|###/\u001b[48;5;19m'\u001b[48;5;21m|\u001b[6;52H|\u001b[7;43H|###\\.\u001b[7;53H||\u001b[8;36H\u001b[48;5;226m#\u001b[48;5;21m#\u001b[8;44H#/\u001b[8;47H#\\\u001b[8;50H#\u001b[8;53H\\\u001b[8;55H|\u001b[9;36H\u001b[48;5;196m#\u001b[9;38H\u001b[48;5;21m\\\\\u001b[9;42H###|\u001b[9;47H/\\##\u001b[9;54H/\u001b[48;5;51m|\u001b[10;37H\u001b[48;5;196m\\\u001b[48;5;51m/#\u001b[48;5;27m#\u001b[48;5;21m/\u001b[48;5;51m\\#\u001b[48;5;21m#\\/||/\\\u001b[48;5;27m#\u001b[48;5;51m#\u001b[10;54H\u001b[48;5;39m|\u001b[11;40H\u001b[48;5;154m#\u001b[48;5;21m|\u001b[48;5;39m|\u001b[48;5;51m#\u001b[48;5;21m#\u001b[11;46H\u001b[48;5;27m#\u001b[11;48H\u001b[48;5;45m/\u001b[48;5;21m||\u001b[48;5;45m/\u001b[12;41H\u001b[48;5;226m\\\u001b[48;5;51m/\u001b[48;5;21m##\u001b[12;46H\u001b[48;5;51m#\u001b[48;5;21m#\u001b[12;49H'\u001b[48;5;51m|\u001b[13;43H\u001b[48;5;226m#\u001b[48;5;50m#\u001b[48;5;51m#\u001b[13;47H\u001b[48;5;21m/\u001b[14;45H\u001b[48;5;226m/\u001b[48;5;21m\\\u001b[15;45H\u001b[48;5;45m|\u001b[48;5;20m|\u001b[48;5;51m/\u001b[16;44H\u001b[48;5;45m-\u001b[48;5;19m'\u001b[48;5;17m`'\u001b[17;43H,.\u001b[18;43H`'\u001b[48;5;16m \u001b[19;43H\u001b[48;5;17m,\u001b[48;5;20m_\u001b[48;5;19m.\u001b[19;47H\u001b[48;5;16m  \u001b[20;43H\u001b[48;5;17m`\u001b[48;5;20m-\u001b[48;5;19m'\u001b[20;47H\u001b[48;5;16m \u001b[48;5;17m,.\u001b[21;36H\u001b[48;5;154m\\\u001b[48;5;17m.,.\u001b[21;41H,\u001b[48;5;19m_\u001b[21;48H|\u001b[48;5;21m\\\u001b[48;5;19m.\u001b[21;53H\u001b[48;5;17m,.\u001b[22;36H\u001b[48;5;154m#\u001b[48;5;19m|\u001b[48;5;21m|\\\u001b[22;41H/\u001b[48;5;20m\\\u001b[22;45H.\u001b[48;5;17m,\u001b[22;53H\u001b[48;5;21m/\\\u001b[23;36H\u001b[48;5;154m#\u001b[48;5;21m\\\u001b[23;40H#\u001b[23;42H\u001b[48;5;20m/\u001b[48;5;19m|\u001b[23;45H\u001b[48;5;21m\\/#/\u0